FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY elections/src/ElectionService.Web/ElectionService.Web.csproj elections/src/ElectionService.Web/
COPY platform/src/Egov.Platform.Identity/Egov.Platform.Identity.csproj platform/src/Egov.Platform.Identity/
COPY platform/src/Egov.Platform.Localization/Egov.Platform.Localization.csproj platform/src/Egov.Platform.Localization/

RUN dotnet restore elections/src/ElectionService.Web/ElectionService.Web.csproj

COPY elections/ elections/
COPY platform/ platform/
RUN dotnet publish elections/src/ElectionService.Web/ElectionService.Web.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

USER 1001:1001
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "ElectionService.Web.dll"]