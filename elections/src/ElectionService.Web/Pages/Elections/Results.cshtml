@page "/elections/{identifier}/results"
@model ElectionService.Web.Pages.Elections.ResultsModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = Model.Results is not null ? $"{Model.Results.Title} — {L["Results"]}" : L["Results"];
}

<div class="content-width workspace-page">
    <a class="back-link" asp-page="/Elections/Detail" asp-route-identifier="@Model.Identifier">@L["BackToElection"]</a>

    @if (Model.Results is null)
    {
        <div class="empty-state"><h1>@L["ResultsNotAvailable"]</h1><p>@L["ResultsNotAvailableDescription"]</p></div>
    }
    else
    {
        var r = Model.Results;
        <header class="workspace-header">
            <div>
                <p class="eyebrow">@ElectionDisplay.Status(r.Status, L) @(r.IsLive ? $"· {L["LiveIntermediate"]}" : "")</p>
                <h1>@r.Title</h1>
            </div>
            <a class="secondary-link" href="@($"{(Configuration["ElectionApi:PublicBaseUrl"] ?? Configuration["ElectionApi:BaseUrl"] ?? "http://localhost:8085").TrimEnd('/')}/public/elections/{r.ElectionId}/results.csv")">@L["Download CSV"]</a>
        </header>

        <section class="workspace-section">
            <div class="section-heading compact"><h2>@L["Turnout"]</h2></div>
            <dl class="record-list">
                @if (r.EligibleVoters.HasValue) { <div><dt>@L["EligibleVoters"]</dt><dd>@r.EligibleVoters.Value.ToString("N0")</dd></div> }
                <div><dt>@L["ParticipatingVoters"]</dt><dd>@r.ParticipatingVoters.ToString("N0")</dd></div>
                <div><dt>@L["ValidBallots"]</dt><dd>@r.TotalValidBallots.ToString("N0")</dd></div>
                @if (r.TurnoutPercentage.HasValue) { <div><dt>@L["Turnout"]</dt><dd>@r.TurnoutPercentage.Value.ToString("F2") %</dd></div> }
            </dl>
            <p class="muted-text">@L["Generated"] @r.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
        </section>

        @if (r.Rows.Count > 0)
        {
            <section class="workspace-section">
                <div class="section-heading compact"><h2>@L["Vote distribution"]</h2></div>
                @{
                    var palette = new[] { "#006fbe", "#d1495b", "#2f7d32", "#d18b00", "#6f4c8b", "#00838f", "#8c564b", "#566573" };
                    var cumulative = 0m;
                    var segments = new List<string>();
                    for (var index = 0; index < r.Rows.Count; index++)
                    {
                        var end = cumulative + r.Rows[index].Percentage;
                        segments.Add($"{palette[index % palette.Length]} {cumulative.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}% {end.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%");
                        cumulative = end;
                    }
                }
                <div class="results-visual">
                    @if (r.TotalValidBallots > 0)
                    {
                        <div class="results-pie" style="background: conic-gradient(@string.Join(", ", segments))" role="img" aria-label="@L["Vote distribution chart"]"></div>
                    }
                    <ol class="results-legend">
                        @for (var index = 0; index < r.Rows.Count; index++)
                        {
                            var row = r.Rows[index];
                            <li><span style="background:@palette[index % palette.Length]"></span><strong>@row.SelectionLabel</strong> @row.Percentage.ToString("F2") %</li>
                        }
                    </ol>
                </div>
                <div class="section-heading compact"><h2>@L["ResultsTable"]</h2></div>
                <table class="data-table results-table">
                    <thead><tr><th>@L["Party"]</th><th>@L["List or option"]</th><th>@L["Votes"]</th><th>%</th></tr></thead>
                    <tbody>
                        @foreach (var row in r.Rows.OrderByDescending(x => x.VoteCount))
                        {
                            <tr>
                                <td>@row.PartyName</td>
                                <td>@row.SelectionLabel</td>
                                <td class="numeric">@row.VoteCount.ToString("N0")</td>
                                <td class="numeric">@row.Percentage.ToString("F2") %</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            @if (r.PartyGroups.Count > 0)
            {
                <section class="workspace-section">
                    <div class="section-heading compact"><h2>@L["Candidates by party list"]</h2></div>
                    @foreach (var party in r.PartyGroups.OrderByDescending(item => item.VoteCount))
                    {
                        <section class="public-result-group">
                            <header><div><h3>@party.ListName</h3><p>@party.PartyName</p></div><strong>@party.VoteCount.ToString("N0") · @party.Percentage.ToString("F2") %</strong></header>
                            <ol>
                                @foreach (var candidate in party.Candidates.OrderBy(item => item.Position))
                                {
                                    <li class="@(candidate.IsWithdrawn ? "withdrawn" : null)"><span>@candidate.DisplayName</span>@if (candidate.IsWinner) { <strong class="winner-badge">@L["Elected"]</strong> }</li>
                                }
                            </ol>
                        </section>
                    }
                </section>
            }
        }
    }
</div>
