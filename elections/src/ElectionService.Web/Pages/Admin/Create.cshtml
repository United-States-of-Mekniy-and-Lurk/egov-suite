@page
@model ElectionService.Web.Pages.Admin.CreateModel
@{ ViewData["Title"] = L["Create election"]; }

<div class="content-width form-page">
    <a class="back-link" asp-page="/Admin/Index">@L["Back to dashboard"]</a>
    <header><p class="eyebrow">@L["Election administration"]</p><h1>@L["Create election"]</h1></header>
    <form method="post" class="admin-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="validation-summary" role="alert">@Model.ErrorMessage</div> }
        <fieldset>
            <legend>@L["Public record"]</legend>
            <div class="field"><label asp-for="Input.Slug">@L["Record slug"]</label><input asp-for="Input.Slug" /><span asp-validation-for="Input.Slug"></span></div>
            <div class="field"><label asp-for="Input.Title">@L["Title"]</label><input asp-for="Input.Title" /><span asp-validation-for="Input.Title"></span></div>
            <div class="field"><label asp-for="Input.Description">@L["Description"]</label><textarea asp-for="Input.Description" rows="5"></textarea><span asp-validation-for="Input.Description"></span></div>
            <div class="form-grid">
                <div class="field"><label asp-for="Input.Type">@L["Type"]</label><select asp-for="Input.Type"><option value="PartyList">@L["Type_PartyList"]</option><option value="Referendum">@L["Type_Referendum"]</option></select></div>
                <div class="field"><label asp-for="Input.EligibilityMode">@L["Eligibility"]</label><select asp-for="Input.EligibilityMode"><option value="AllActiveCitizens">@L["Eligibility_AllActiveCitizens"]</option><option value="SpecificVoterRoll">@L["Eligibility_SpecificVoterRoll"]</option></select></div>
            </div>
            <div class="form-grid">
                <div class="field"><label asp-for="Input.VotingStartsAt">@L["Voting starts"]</label><input asp-for="Input.VotingStartsAt" type="datetime-local" /></div>
                <div class="field"><label asp-for="Input.VotingEndsAt">@L["Voting ends"]</label><input asp-for="Input.VotingEndsAt" type="datetime-local" /></div>
            </div>
            <div class="field"><label asp-for="Input.TerritoryCode">@L["Territory code"]</label><input asp-for="Input.TerritoryCode" /></div>
            <div class="field"><label asp-for="Input.EligibleVoterCount">@L["Eligible voters (optional)"]</label><input asp-for="Input.EligibleVoterCount" type="number" min="0" /></div>
        </fieldset>
        <div class="form-actions"><a class="secondary-link" asp-page="/Admin/Index">@L["Cancel"]</a><button class="primary-button" type="submit">@L["Create election"]</button></div>
    </form>
</div>

@section Scripts { <partial name="Shared/_ValidationScriptsPartial" /> }