@page
@model ElectionService.Web.Pages.Admin.IndexModel
@{ ViewData["Title"] = L["Election administration"]; }

<div class="content-width workspace-page">
    <header class="workspace-header">
        <div><p class="eyebrow">@L["Election administration"]</p><h1>@L["Election dashboard"]</h1></div>
        <div class="header-actions"><a class="secondary-link" asp-page="/Admin/HistoricalImport">@L["Import historical record"]</a><a class="primary-link" asp-page="/Admin/Create">@L["Create election"]</a></div>
    </header>

    <section class="workspace-section" aria-labelledby="records-heading">
        <div class="section-heading"><h2 id="records-heading">@L["Public election records"]</h2></div>
        @if (Model.IsUnavailable)
        {
            <div class="notice notice-error">@L["Election records are temporarily unavailable."]</div>
        }
        else if (Model.Elections.Count == 0)
        {
            <div class="empty-state"><h3>@L["No public records"]</h3><p>@L["Create an election to begin."]</p></div>
        }
        else
        {
            <div class="management-list">
                @foreach (var election in Model.Elections.OrderByDescending(item => item.VotingStartsAt))
                {
                    <article>
                        <div><h3>@election.Title</h3><p>@ElectionDisplay.Type(election.Type, L) · @election.VotingStartsAt.ToString("d MMM yyyy")@if (election.IsHistorical) { <span> · @L["Historical record"]</span> }</p></div>
                        <span class="status status-@election.Status.ToLowerInvariant()">@ElectionDisplay.Status(election.Status, L)</span>
                        <div class="row-links"><a asp-page="/Admin/Manage" asp-route-id="@election.Id" asp-route-title="@election.Title">@L["Manage"]</a><a asp-page="/Elections/Detail" asp-route-identifier="@election.Slug">@L["Public record"]</a></div>
                    </article>
                }
            </div>
        }
    </section>
</div>