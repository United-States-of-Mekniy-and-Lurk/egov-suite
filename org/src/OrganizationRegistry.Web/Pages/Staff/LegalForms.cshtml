@page "/staff/legal-forms"
@model OrganizationRegistry.Web.Pages.Staff.LegalFormsModel
@{ ViewData["Title"] = L["ManageLegalForms"]; }

<div class="content-width workspace-page">
    <header class="workspace-header"><div><p class="eyebrow">@L["RegistryAdministration"]</p><h1>@L["ManageLegalForms"]</h1><p>@L["ManageLegalFormsDescription"]</p></div></header>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="notice notice-error" role="alert">@Model.ErrorMessage</div> }

    <section class="workspace-section" aria-labelledby="add-legal-form">
        <div class="section-heading compact"><h2 id="add-legal-form">@L["AddLegalForm"]</h2></div>
        <form method="post" asp-page-handler="Create" class="legal-form-editor legal-form-create">
            <label><span>@L["Code"]</span><input name="code" required maxlength="80" /></label>
            <label><span>@L["EnglishLabel"]</span><input name="labelEn" required maxlength="160" /></label>
            <label><span>@L["CzechLabel"]</span><input name="labelCs" required maxlength="160" /></label>
            <label><span>@L["SortOrder"]</span><input name="sortOrder" type="number" value="100" /></label>
            <button class="primary-button" type="submit">@L["AddLegalForm"]</button>
        </form>
    </section>

    <section class="workspace-section" aria-labelledby="legal-forms">
        <div class="section-heading compact"><h2 id="legal-forms">@L["ExistingLegalForms"]</h2></div>
        <div class="legal-form-list">
            @foreach (var legalForm in Model.LegalForms)
            {
                <form method="post" asp-page-handler="Update" class="legal-form-editor">
                    <input type="hidden" name="code" value="@legalForm.Code" />
                    <div class="legal-form-code"><strong>@legalForm.Code</strong><span class="status">@(legalForm.IsActive ? L["Active"] : L["Inactive"])</span><a asp-page="/Staff/LegalFormDetail" asp-route-code="@legalForm.Code" class="small-link">@L["EditDescription"]</a></div>
                    <label><span>@L["EnglishLabel"]</span><input name="labelEn" value="@legalForm.LabelEn" required maxlength="160" /></label>
                    <label><span>@L["CzechLabel"]</span><input name="labelCs" value="@legalForm.LabelCs" required maxlength="160" /></label>
                    <label><span>@L["SortOrder"]</span><input name="sortOrder" type="number" value="@legalForm.SortOrder" /></label>
                    <label class="checkbox-field"><input name="isActive" type="checkbox" value="true" checked="@legalForm.IsActive" /><span>@L["Active"]</span></label>
                    <button class="secondary-button" type="submit">@L["SaveChanges"]</button>
                </form>
            }
        </div>
    </section>
</div>